# 复制为 .env 后填写真实值；.env 不要提交进 git
# compose 中所有 ${VAR:?} 项在缺失时会直接拒绝启动，这是有意为之

# ---- 镜像与端口 ------------------------------------------------------------
# Docker Hub 用户名（命名空间），例如 hamily
DOCKERHUB_USER=${DOCKERHUB_USER}
# 完整镜像引用，留空则使用 docker-compose.yml 里的默认 ${DOCKERHUB_USER}/reader:2.5.4
READER_IMAGE=${DOCKERHUB_USER}/reader:2.5.4
# 宿主机映射端口
READER_PORT=4396

# ---- 鉴权（必填，不要使用默认值）-------------------------------------------
# 管理员密码。上游默认 ""，等于无鉴权
READER_SECURE_KEY=change-me-admin-password
# 注册邀请码。上游默认 ""，等于任何人可注册
READER_INVITE_CODE=change-me-invite-code

# ---- 业务配额 --------------------------------------------------------------
READER_USER_LIMIT=50
READER_USER_BOOK_LIMIT=200
